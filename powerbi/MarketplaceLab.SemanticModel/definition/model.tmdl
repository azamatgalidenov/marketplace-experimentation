/// Marketplace Checkout & Experimentation Lab. REAL Olist history and a SIMULATED checkout experiment, kept in disconnected parts of the model.
model MarketplaceLab
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Orders","Order Items","Payments","Date","Customer Region","Product Category","SIM Scenario","SIM Experiment Users","SIM Metric Results","SIM Segment Results","SIM Daily Assignments","SIM Variant Metrics","SIM Power Plan","SIM Quality Checks","DataFolder"]

ref table Orders
ref table 'Order Items'
ref table Payments
ref table Date
ref table 'Customer Region'
ref table 'Product Category'
ref table 'SIM Scenario'
ref table 'SIM Experiment Users'
ref table 'SIM Metric Results'
ref table 'SIM Segment Results'
ref table 'SIM Daily Assignments'
ref table 'SIM Variant Metrics'
ref table 'SIM Power Plan'
ref table 'SIM Quality Checks'

ref cultureInfo en-US

